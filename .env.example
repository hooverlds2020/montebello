# Copia este archivo como ".env" en la misma carpeta que docker-compose.yml,
# y rellena los valores reales. El archivo ".env" NUNCA se sube a git
# (ya está en .gitignore) — solo esta plantilla, sin datos reales.

# --- Base de datos ---
POSTGRES_PASSWORD=cambia_esta_clave
PGPASSWORD=cambia_esta_clave

# --- Panel de administración ---
ADMIN_PASSWORD=cambia_esta_clave_admin
ADMIN_JWT_SECRET=genera_un_texto_largo_y_aleatorio_aqui

# --- Sesión de alumnos ---
ALUMNO_JWT_SECRET=genera_otro_texto_largo_y_aleatorio_distinto

# --- Sitio ---
SITE_URL=https://montebello.clicknube.site

# --- Correo (opcional, para recuperación de contraseña) ---
# Si se dejan vacías, el link de recuperación queda en los logs del contenedor
# (docker logs montebello-app) en vez de enviarse por correo real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
